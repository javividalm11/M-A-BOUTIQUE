# Ejemplo de configuración para Cloudflare (opcional, si usas Wrangler CLI).
# Si despliegas con Git desde el panel, NO necesitas este archivo:
# enlaza el KV desde el panel (ver SETUP-DASHBOARD.md).
#
# Para usarlo con Wrangler: copia este archivo como "wrangler.toml" y rellena el ID.

name = "maboutique"
pages_build_output_dir = "."

# --- Base KV (guarda textos, fotos y PDFs) ---
[[kv_namespaces]]
binding = "MA_KV"
id = "PON_AQUI_EL_ID_DE_maboutique-content"

# --- Contraseña del panel (mejor como Secret en el panel) ---
# [vars]
# ADMIN_PASSWORD = "m&Aboutiqu3"
